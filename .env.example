# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use SQLite for local smoke tests.
# For Postgres (docker-compose):
# DATABASE_URL=postgres://gitpulse:gitpulse@localhost:5432/gitpulse

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True to run tasks inline without a worker (dev convenience)
CELERY_TASK_ALWAYS_EAGER=True

# GitHub — **strongly recommended**. Without a token, public API rate limits
# (60 req/hr) will skip or truncate PR/review data. Commits still analyze fine.
GITHUB_TOKEN=

# Ingestion
INGESTION_COMMIT_CAP=2000

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
